# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# URL publique pour Swagger « Try it out » (sinon seul localhost est proposé).
# Sur Render, RENDER_EXTERNAL_URL est injecté automatiquement — pas besoin de dupliquer.
# SWAGGER_PUBLIC_URL=https://dizipay-api.onrender.com
# CORS : liste séparée par des virgules, ou vide = tout origine (mobile React Native + tests).
# Expo Web / front : ajoutez l’URL exacte (ex. https://xxx.exp.direct).
# CORS_ORIGIN=http://localhost:5173,https://app.dizipay.example

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://dizipay:password@localhost:5432/dizipay_db?schema=public"
# Schéma : migrations dans prisma/migrations — en prod, `npm run start:prod` exécute
# `prisma migrate deploy` avant de démarrer (Render, etc.). Ensuite : `npx prisma db seed` une fois.

# ==========================================
# REDIS
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# JWT
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=1h
JWT_EXPIRATION_SEC=3600
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRATION=7d

# ==========================================
# PI-SPI BCEAO — SANDBOX (simulateur, dashboard PI-SPI)
# ==========================================
# Exemple « Participant & comptes » : URL API BUSINESS + URL serveur d’autorisation Cognito
PISPI_BASE_URL=https://no-mtls.piz.simulateurs.pi-bceao.com
PISPI_TOKEN_URL=https://piz-simulateur-business-sandbox.auth.eu-west-1.amazoncognito.com/oauth2/token
PISPI_CLIENT_ID=your_client_id_from_dashboard_credentials
PISPI_CLIENT_SECRET=your_client_secret_from_dashboard_credentials
# Code participant simulateur affiché (ex. SNB999) pour X-Institution-Id
PISPI_INSTITUTION_ID=SNB999
PISPI_COUNTRY_CODE=SN
PISPI_WEBHOOK_SECRET=your_webhook_secret_change_me
# En-tête attendu pour HMAC-SHA256 du corps brut (hex, 64 caractères)
# PISPI_WEBHOOK_SIGNATURE_HEADER=x-pispi-signature
# PISPI_API_KEY=optional_if_required_by_api

PISPI_TOKEN_EXPIRATION=300

# ==========================================
# PI-SPI BCEAO (PRODUCTION)
# ==========================================
# PISPI_BASE_URL=https://api.pispi.bceao.int
# PISPI_CLIENT_ID=your_production_client_id
# PISPI_CLIENT_SECRET=your_production_client_secret

# ==========================================
# RATE LIMITING
# ==========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/dizipay.log

# ==========================================
# SENTRY (Optionnel)
# ==========================================
SENTRY_DSN=
